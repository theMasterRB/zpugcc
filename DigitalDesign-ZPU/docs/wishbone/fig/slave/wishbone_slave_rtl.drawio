        <mxCell id="SZWKpM0Z08KSQ51kJHtJ-5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="&lt;span style=&quot;font-size: 19px; color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;FSM Next State Logic&lt;/b&gt;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;pre dir=&quot;ltr&quot; style=&quot;&quot;&gt;&lt;code style=&quot;font-size: 19px; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;pre dir=&quot;ltr&quot; style=&quot;font-size: 11px;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;state_n = state&lt;/span&gt;&lt;/font&gt;&lt;/pre&gt;&lt;font face=&quot;Helvetica&quot;&gt;IF (state == IDLE) AND (slave.CYC AND&lt;/font&gt;&lt;font face=&quot;Helvetica&quot;&gt; slave.&lt;/font&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;background-color: transparent; white-space: normal;&quot;&gt;STB)&lt;/font&gt;&lt;/code&gt;&lt;font&gt;&lt;span&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 19px; white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;state_n = ACTIVE&lt;/span&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;font color=&quot;rgba(0, 0, 0, 0)&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;br&gt;ELSE IF (state == ACTIVE) &lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-family: Helvetica; font-size: 19px; white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;IF NOT &lt;/span&gt;&lt;/font&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;slave.CYC OR NOT slave.STB&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-family: Helvetica; color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;&lt;br&gt;               &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;state_n = IDLE&lt;/span&gt;&lt;/span&gt;&lt;font color=&quot;rgba(0, 0, 0, 0)&quot;&gt;&lt;span style=&quot;font-family: Helvetica; font-size: 19px; color: rgb(0, 0, 0);&quot;&gt;&lt;br&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;         ELSE IF NOT bus_if.request_stall&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;state_n = ACKNOWLEDGE&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;pre dir=&quot;ltr&quot; style=&quot;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;ELSE IF (state == ACKNOWLEDGE) OR (state == ERROR)&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 19px; white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/font&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; white-space: normal;&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;IF NOT &lt;/span&gt;&lt;/font&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 19px; white-space: normal;&quot;&gt;slave.CYC OR NOT slave.STB&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 19px;&quot;&gt;state_n = IDLE&lt;/font&gt;&lt;br&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
