CAPI=2:
name: socet:bus-components:wishbone_if:0.0.1
description: "Wishbone bus interface" 

filesets:
    rtl:
        files:
            - wishbone_if.sv
        file_type: systemVerilogSource

targets:
    default: &default
        filesets:
            - rtl
        toplevel: wishbone_if
    
    sim:
        <<: *default
        description: Simulate
        default_tool: xcelium

    lint:
        <<: *default
        description: Linting
        default_tool: veriblelint
