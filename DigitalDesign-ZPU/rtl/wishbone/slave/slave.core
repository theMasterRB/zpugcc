CAPI=2:
name: socet:bus-components:wb_slave:0.1.0
description: "Wishbone Slave Module and Testbench" 

filesets:
    rtl:
        depend:
            - "socet:bus-components:bus_protocol_if:0.0.1"
            - "socet:bus-components:wishbone_if:0.0.1"
        files:
            - src/slave.sv
        file_type: systemVerilogSource


    tb:
        depend:
            - "socet:bus-components:dummy_peripheral:0.0.1"
        files:
            - tb/tb_slave.sv
        file_type: systemVerilogSource

targets:
    default: &default
        filesets:
            - rtl
        toplevel: slave


    sim:
        <<: *default
        filesets_append:
            - tb
        description: Simulate w/TB
        default_tool: verilator
        toplevel: tb_slave
        tools:
            xcelium:
                xrun_options:
                    - +xmtimescale+1ns/100ps
            verilator:
                verilator_options:
                    - --assert
                    - --binary
                    - --trace-fst
                    - --trace-structs
                    - -Wno-SYMRSVDWORD
                    - -Wno-TIMESCALEMOD
                    - -Wno-lint
                    - -CFLAGS -std=c++20
            modelsim:
                vsim_options:
                    - -vopt
                    - -voptargs='+acc'
                    - -t
                    - ps

    lint:
        filesets:
            - rtl
            - tb
        description: Linting
        default_tool: veriblelint
        toplevel: tb_slave
        tools:
            veriblelint:
                verible_lint_args: ['--rules_config_search']
