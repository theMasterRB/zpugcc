CAPI=2:
name: socet:bus-components:dummy_peripheral:0.0.1
description: Simple memory using bus_protocol_if for testing bus managers

filesets:
    rtl:
        depend:
            - "socet:bus-components:bus_protocol_if:0.0.1"
        files:
            - dummy_peripheral.sv
        file_type: systemVerilogSource
        
targets:
    default:
        filesets:
            - rtl
        toplevel: dummy_peripheral